# ==============================================================================
# NOVA EXECUTIVE ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or load these variables into your n8n environment.

# ------------------------------------------------------------------------------
# GOOGLE CLOUD PLATFORM & GEMINI API CONFIGURATION
# ------------------------------------------------------------------------------
# GCP Project ID created during setup (e.g. lester-labs)
GCP_PROJECT_ID=lester-labs

# Google Gemini API Key (Gemini 3.6 Flash / Vertex AI)
GEMINI_API_KEY=AIzaSy...YourGeminiApiKeyHere

# Default Gemini Model Endpoint for Audio Parsing & Intent Evaluation
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 100% HANDS-FREE SIRI VOICE ORCHESTRATION
# ------------------------------------------------------------------------------
# Primary interactive channel: Spoken responses delivered directly to Siri's
# HTTP connection. No external chat webhooks required!
# (Optional) AUDIT_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ------------------------------------------------------------------------------
# GOOGLE WORKSPACE API CREDENTIALS (n8n OAuth2 / Service Account)
# ------------------------------------------------------------------------------
# Note: In n8n, these credentials are standard OAuth2 or Service Account Key JSON files.
# Google Workspace Scope Requirements:
# - https://www.googleapis.com/auth/tasks
# - https://www.googleapis.com/auth/calendar
# - https://www.googleapis.com/auth/drive
# - https://www.googleapis.com/auth/documents

# ------------------------------------------------------------------------------
# n8n WEBHOOK & INSTANCE CONFIGURATION
# ------------------------------------------------------------------------------
# Public URL of your n8n instance
N8N_HOST=https://automation.lesterlabs.cloud

N8N_API_URL=https://automation.lesterlabs.cloud
