    {
      "parameters": {
        "jsCode": "const trigger = $('Execute Workflow Trigger').item.json;\nconst intent = trigger.intent || 'TASK';\nconst title = (trigger.parameters && trigger.parameters.title) ? trigger.parameters.title : ((trigger.parameters && trigger.parameters.details) ? trigger.parameters.details : (trigger.raw_input || 'Item'));\nconst dateTime = trigger.parameters ? trigger.parameters.date_time : null;\n\nlet formattedTime = '';\nif (dateTime) {\n  try {\n    const validDtStr = /Z|[+-]\\d{2}:\\d{2}$/.test(dateTime) ? dateTime : dateTime + '-05:00';\n    const dt = new Date(validDtStr);\n    formattedTime = dt.toLocaleTimeString('en-US', { timeZone: 'America/Chicago', hour: 'numeric', minute: '2-digit', hour12: true });\n  } catch (e) {\n    formattedTime = dateTime;\n  }\n}\n\nlet msg = '';\nif (intent === 'CALENDAR') {\n  msg = `I scheduled ${title} on your Google Calendar${formattedTime ? ' for ' + formattedTime : ''}.`;\n} else {\n  msg = `I added ${title} to your Google Tasks${formattedTime ? ' due at ' + formattedTime : ''}.`;\n}\n\nreturn {\n  json: {\n    status: 'COMPLETED',\n    intent: intent,\n    message: msg\n  }\n};"
      },
      "id": "6e54a30d-650b-401a-9279-e457299a5ef8",
      "name": "Format Spoken Task Output",
      "type": "n8n-nodes-base.code",
