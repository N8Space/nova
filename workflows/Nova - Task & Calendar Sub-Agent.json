        "task": "MDI0NzUyMTIwNjg3NDg0Njc4NzE6MDow",
        "title": "={{ $json.parameters.title || $json.parameters.details || $json.raw_input || 'New Task' }}",
        "additionalFields": {
          "due": "={{ $json.parameters.date_time ? new Date(/Z|[+-]\\d{2}:\\d{2}$/.test($json.parameters.date_time) ? $json.parameters.date_time : $json.parameters.date_time + '-05:00').toISOString().split('T')[0] + 'T00:00:00.000Z' : '' }}",
          "notes": "={{ ($json.parameters.date_time ? 'Due at ' + new Date(/Z|[+-]\\d{2}:\\d{2}$/.test($json.parameters.date_time) ? $json.parameters.date_time : $json.parameters.date_time + '-05:00').toLocaleTimeString('en-US', {timeZone: 'America/Chicago', hour: 'numeric', minute: '2-digit', hour12: true}) + '. ' : '') + ($json.parameters.details || 'Added by Nova Executive Assistant') }}"
        }
